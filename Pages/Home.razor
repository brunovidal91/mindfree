@page "/"
@page "/dashboard"
@inject IMonthList MonthList
@inject AppState State
@implements IDisposable
@inject IMonthList MonthList

@inject HttpClient HttpClient
@inject ICookie Cookie
@inject NavigationManager NavigationManager

<PageTitle>painel</PageTitle>
<SectionContent SectionName="Top">
	<p class="text-center mt-3">Painel Administrativo • @_currentMonthName • @State.CurrentYear </p>
</SectionContent>

<img src="@(_isShowedValues ? "icon-opened-eye" : "icon-blind-eye").png" id="img-eye" @onclick="HideValues" />
<img src="icon-refresh-30.png" id="img-refresh" @onclick="RefreshPage" />

<div class="d-flex flex-row mb-3 gap-4" id="input-month">
	@* <label class="lbl">Mês atual</label> *@
	<select class="form-select" @onchange="UpdateSelectedMonth" style="width: 150px; height: 40px;">
		@foreach (Month month in MonthList.Months().Take(12))
		{
			<option value=@month.MonthPosition selected="@(month.MonthPosition == DateTime.Now.Month)">@month.MonthName</option>
		}

	</select>
	<button @onclick="ChangeCurrentMonthStatus" type="button" class="btn btn-secondary" id="btn-fechamento" style="background-color: @( _isClosed ? "tomato" : "#28aab9"); border: none;">@( _isClosed ? "Reabrir mês" : "Fechar mês")</button>
	
	
	<div class="load @rotacionar" style="margin-top: 8px; margin-left: -15px;"></div>


</div>

<section id="results-card-section">

	<div class="results-card" id="card-percent">
		<div class="results-lbl-container">
			<label class="results-value-label">@(_econommyCard.ToString("F1")) %</label>
			<label class="results-title-label">Economia</label>
		</div>
		<img src="icon-percent.png" width="40" height="40" />
	</div>

	<div class="results-card" id="card-saidas">
		<div class="results-lbl-container">
			<label class="results-value-label">R$ @(_isShowedValues ? _expensesCard.ToString("F2") : "***")</label>
			<label class="results-title-label">Total saídas</label>
		</div>
		<img src="icon-decrease.png" width="40" height="40" />
	</div>

	<div class="results-card" id="card-entradas">
		<div class="results-lbl-container">
			<label class="results-value-label">R$ @(_isShowedValues ? _incomeCard.ToString("F2") : "***")</label>
			<label class="results-title-label">Total entradas</label>
		</div>
		<img src="icon-increase.png" width="40" height="40" />
	</div>

	<div class="results-card" id="card-saldo">
		<div class="results-lbl-container">
			<label class="results-value-label">R$ @(_isShowedValues ? _totalCard.ToString("F2") : "***")</label>
			<label class="results-title-label">Saldo atual</label>
		</div>
		<img src="icon-saldo.png" width="45" height="45" />
	</div>
</section>




<section id="category-section">

	
	<div  style="position: relative">
	<div style="position: absolute; top: -25px; left: 1px;">
		<div class="form-check form-switch">
			<input class="form-check-input" type="checkbox" role="switch" id="@(isIncomeList ? "switchCheckChecked" : "switchCheckDefault")" @onclick="ChangeViewCategories" style="background-color: var(--roxoCard)">
			<label class="form-check-label" for="switchCheckChecked">Ver as @(isIncomeList ? "Despesas" : "Receitas")</label>
		</div>
	</div>

		<label class="category-cards-title">@(isIncomeList ? "Ganhos" : "Gastos") por Categoria</label> 
		<div id="category-compare-area">

			<div id="category-compare-itens" style="width: 100%; margin-top: 10px;">
				@foreach (CategoryCompare category in categoryCompares.OrderDescending())
				{
					<div class="d-flex gap-5">
						<span style="color: #ff5; font-size: 14px; width: 140px; white-space: nowrap;">@category.Title</span>
						<span style="text-align: left; font-size: 13px; color: #fff;">R$ @(_isShowedValues ? category.Value.ToString("F2") : "***")</span>
						<span></span>
					</div>

					<div class="progress" role="progressbar" aria-label="Example with label" aria-valuenow="25" aria-valuemin="0" aria-valuemax="@_expensesCard.ToString()">
						<div class="progress-bar" style="width: @(category.Percentage.ToString("F0"))%; background-color: var(--roxoCardOld);">
							@(category.Percentage.ToString("F0"))%
						</div>
					</div>
				}

			</div>
		</div>
	</div>
	@* --------------- Contas Mensais ----------------*@
	<div>
		<label class="next-payments-cards-title">Contas Mensais</label>
		<div id="category-next-payments-area">
			<div id="category-next-payments-itens">
				<table class="table" style="width: 340px; max-width: 360px;">
					<thead>
						<tr style="color: #fff; font-size: 14px;">
							<th>Dia</th>
							<th colspan="2">Conta</th>
							<th colspan="2">Valor à Pagar</th>
							<th></th>
						</tr>
					</thead>
					<tbody>
						@foreach (ExpectedPayment expectedPayment in expectedPayments.OrderBy(item => int.Parse(item.Date)))
						{
							

							<tr style="color: @( int.Parse(expectedPayment.Date) == _today && _currentMonthIndex == DateTime.Now.Month? "var(--amareloLoad)" : (expectedPayment.Transaction != null && expectedPayment.Transaction.isPaid ? "var(--verdePrincipal)" : "#fff")); font-size: 14px;">
								<td>@expectedPayment.Date</td>
								<td colspan="2">@expectedPayment.Name</td>
								<td colspan="2">R$ @(_isShowedValues ? expectedPayment.Value.ToString("F2") : "***")</td>
								<td>
									@if (!String.IsNullOrEmpty(expectedPayment?.Transaction?.Category?.title) && expectedPayment.Transaction.isPaid == true)
									{
										<img src="icons8-check-48.png" width="20" height="20" id="img-check" @onclick="@(() => AlterPaid(expectedPayment))"/>
									}
									else
									{
										if (!String.IsNullOrEmpty(expectedPayment?.Transaction?.Category?.title))
										{
											<img src="uncked-circle-48.png" width="20" height="20" id="img-uncheck" @onclick="@(() => AlterPaid(expectedPayment))"/>

										} 

									}

								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>

	</div>

	<div>
		<label class="investment-title">Total para Investir</label>
		<div id="investment-area">
			<div id="category-next-payments-itens">
				<table class="table" style="width: 240px; max-width: 240px;">
					<thead>
						<tr style="color: #fff; font-size: 14px; text-align: center;">
							<th>Alíquota <span class="text-warning">@(_investmentRate.ToString("F2"))%</span></th>
						</tr>
					</thead>
					<tbody>

							<tr style="color: #fff; font-size: 15px; font-weight: normal;">
								<td style="text-align: center;">R$ @( _isShowedValues ? _totalInvestment.ToString("F2") : "***")</td>
							</tr>
						
					</tbody>
				</table>
			</div>
		</div>

	</div>
</section>

<div id="older_results-title">
	<span>Resumo dos meses anteriores</span>
</div>
<section id="older-results-section">

	@foreach (MonthResult monthResult in monthResults.OrderBy(item => item.MonthIndex))
	{


		@* if(_currentMonthIndex == monthResult.MonthIndex)
		{
			_isClosed = monthResult.IsClosed ? true : false;
			Console.WriteLine(_currentMonthIndex + " " + monthResult.MonthIndex);
		}
		else
		{
			_isClosed = monthResult.IsClosed ? true : false;
			Console.WriteLine(_currentMonthIndex + " " + monthResult.MonthIndex);
		} *@

		<div class="older-month-card" style="border-color: @(monthResult.IsClosed ? "var(--verdePrincipal)" : "tomato")">
			<p class="older-month-title">@monthResult.MonthName</p>
			<div style="font-size: 14px; width: 150px;">
				<div class="d-flex flex-row justify-content-between">
					<span style="color: #ff5;">Saídas:</span>
					<span style="color: #fff;">R$ @(_isShowedValues ? monthResult.Expenses.ToString("F2") : "***")</span>
				</div>
				<div class="d-flex flex-row mt-2 justify-content-between">
					<span style="color: #ff5;">Entradas:</span>
					<span style="color: #fff;">R$ @(_isShowedValues ? monthResult.Incomes.ToString("F2") : "***")</span>
				</div>
				<div class="d-flex flex-row mt-5 justify-content-between">
					<span style="color: #ff5;">Saldo:</span>
					<span style="color: #fff;">R$ @(_isShowedValues ? monthResult.Balance.ToString("F2") : "***")</span>
				</div>
			</div>
		</div>
	}

</section>


@code {

	private int _currentMonthIndex { get; set; }
	private string _currentMonthName { get; set; } = string.Empty;
	private string _currentYear { get; set; }
	private int _today { get; set; }
	private double _econommyCard { get; set; }
	private double _expensesCard { get; set; }
	private double _incomeCard { get; set; }
	private double _totalCard { get; set; }
	private bool _isShowedValues { get; set; } = true;
	private string _eye { get; set; } = string.Empty;
	private double _totalInvestment { get; set; }
	private double _investmentRate { get; set; }
	private bool _isClosed { get; set; } = false;
	private string? rotacionar { get; set; }


	TransactionService? transactionService;
	Dashboard? dashboard;
	List<Transaction> transactions = new();
	List<CategoryCompare> categoryCompares = new();
	CategoryService? categoryService;
	List<Category> categories = new();
	List<ExpectedPayment> expectedPayments = new();
	List<MonthResult> monthResults = new();

	Boolean isIncomeList;


	protected override async Task OnInitializedAsync()
	{
		string showCookie = await Cookie.GetValue("eval");
		if (!string.IsNullOrEmpty(showCookie))
		{
			_isShowedValues = bool.Parse(showCookie);
		}

		_eye = _isShowedValues == true ? "icon-opened-eye" : "icon-blind-eye";
		_today = DateTime.Now.Day;
		_currentMonthIndex = DateTime.Now.Month;
		await GetLists();
		CheckSelectedMonthStatus();

		//States
		State.Notification += StateHasChanged;
		_currentMonthIndex = MonthList.Months()[DateTime.Now.Month - 1].MonthPosition;
		_currentMonthName = MonthList.Months()[DateTime.Now.Month - 1].MonthName!;
	}

	private async Task GetLists()
	{
		string _currentYearCookie = await Cookie.GetValue("config");
		_currentYear = _currentYearCookie.Split(",")[0].Trim();
		_investmentRate = double.Parse(_currentYearCookie.Split(",")[1].Trim());

		if (string.IsNullOrEmpty(_currentYear)) _currentYear = DateTime.Now.Year.ToString();

		transactionService = new(HttpClient, Cookie, NavigationManager);
		transactions = await transactionService.GetTransactions(DateTime.Now.Day.ToString(), "M", _currentMonthIndex.ToString(), _currentYear);

		categoryService = new(HttpClient, Cookie, NavigationManager);
		categories = await categoryService.GetCategories();

		dashboard = new(transactions, _currentMonthIndex.ToString(), categories, isIncomeList, Cookie, HttpClient, _currentYear);
		await dashboard.GetOlderMonthsResult();

		//Preencher os cards de resultados
		_econommyCard = dashboard.EconomyCard;
		_expensesCard = dashboard.ExpensesCard;
		_incomeCard = dashboard.IncomeCard;
		_totalCard = dashboard.TotalCard;

		categoryCompares = dashboard.CategoriesCompare;
		expectedPayments = dashboard.NextPayments;

		_totalInvestment = dashboard.GetTotalInvestment(_totalCard, _investmentRate);
		monthResults = dashboard.MonthResults;
	}

	private void CheckSelectedMonthStatus()
	{
		if(monthResults.Count > 0)
		{
			var checkMonth = monthResults.Where(m => m.MonthIndex == _currentMonthIndex).Where(m => m.IsClosed == true).FirstOrDefault();

			if (checkMonth != null)
			{
				_isClosed = true;
			}
			else
			{
				_isClosed = false;
			}
		}
	}

	private async Task ChangeCurrentMonthStatus()
	{
		rotacionar = "rotacionar";

		try
		{
			ResultService resultService = new ResultService(HttpClient, Cookie);

			if (!_isClosed)
			{
				await resultService.CloseResults(_currentMonthIndex.ToString(), _currentYear);
			}
			else
			{
				await resultService.OpenResult(_currentMonthIndex.ToString(), _currentYear);	
			}

			await GetLists();
			CheckSelectedMonthStatus();

		}
		catch (Exception ex)
		{
			Console.WriteLine(ex);
		}
		finally
		{
			rotacionar = "";
		}



	}

	private async Task UpdateSelectedMonth(ChangeEventArgs e)
	{

		_currentMonthIndex = int.Parse(e.Value.ToString());
		_currentMonthName = MonthList.SelectedMonth(_currentMonthIndex).MonthName!;
		await GetLists();
		CheckSelectedMonthStatus();
	}

	private async Task HideValues()
	{
		_isShowedValues = !_isShowedValues;
		_eye = _isShowedValues == true ? "icon-opened-eye" : "icon-blind-eye";
		await Cookie.SetValue("eval", _isShowedValues.ToString());
	}

	private async Task RefreshPage()
	{
		string _currentYearCookie = await Cookie.GetValue("config");
		_investmentRate = double.Parse(_currentYearCookie.Split(",")[1].Trim());
		_currentYear = _currentYearCookie.Split(",")[0].Trim();
		dashboard = new(transactions, _currentMonthIndex.ToString(), categories, isIncomeList, Cookie, HttpClient, _currentYear);
		await dashboard.GetOlderMonthsResult();
		_totalInvestment = dashboard.GetTotalInvestment(_totalCard, _investmentRate);
	}

	private async Task ChangeViewCategories()
	{
		isIncomeList = !isIncomeList;
		await GetLists();
	}

	private async Task AlterPaid(ExpectedPayment expectedPayment)
	{

		TransactionService transactionService = new(HttpClient, Cookie, NavigationManager);

		try
		{
			if (expectedPayment.Transaction != null)
			{
				await transactionService.EditTransaction(expectedPayment.Transaction, true);
			}

			// await GetLists();

		}
		catch (Exception ex)
		{
			expectedPayment.Transaction.isPaid = false;

		}
	}


	public void Dispose()
	{
		State.Notification -= StateHasChanged;
	}


}