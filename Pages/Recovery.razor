@page "/recovery"
@layout LoginLayout
@using MindFree.Services
@inject HttpClient HttpClient





<div class="login-zone">
	<img src="mindfree.png" alt="logo" style="width: 220px; height: 240px; margin: 10px auto;" />
	<div class="container_input">
		<p class="alert alert-@_status" style="font-size: 14px;">@_msg</p>


		<input type="email" class="form-control text-center" @bind-value="_email" placeholder="e-mail"/>
		<button @onclick="HandleRecovery" class="btn mt-3 form-control" style="background-color: #30e3b3; color: #231058; float: right;">Enviar Link</button>

		<a href="/login">Voltar</a>
	</div>

</div>


@code {

	private string? _msg { get; set; }
	private string _email { get; set; } = string.Empty;
	private string _status { get; set; } = string.Empty;
	// private bool _isSended { get; set; }
	private RecoveryResponse recoveryResponse = new();
	private RecoveryService recoveryService;

	private async Task HandleRecovery()
	{
		recoveryService = new RecoveryService(HttpClient);

		try
		{
			recoveryResponse = await recoveryService.SendLink(_email);

			if (recoveryResponse.IsSuccessStatusCode)
			{
				_msg = "E-mail enviado com sucesso! Verifique sua caixa de entrada";
				_status = "success";

			}
			else
			{
				_msg = recoveryResponse.Message;
				_status = "danger";
			}
		}
		catch (Exception ex)
		{
			_msg = ex.Message;
			_status = "danger";
		}
	}
}
