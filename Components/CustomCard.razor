@inject IJSRuntime JSRuntime
@inject ICookie Cookie

<section class="card-container">
	<p style="background-color: @headColor; color: #fff; width: 100%; text-align: center; border-top-left-radius: 5px; border-top-right-radius: 5px;">@Day</p>
	<div class="list-container">

		@foreach(Transaction transaction in Transactions.OrderByDescending(item => item.Id))
		{
			<div class="line" @ondblclick=@(() => GetTransactionData(transaction)) style="background-color: @(transaction.Category.isIncome && !transaction.Category.isMonthly ? "var(--verdePrincipal)" : ""); border-radius: 5px;" id="@transaction.Id">

				<p style="text-align: left; width: 115px; font-size: 13.5px;">@(string.IsNullOrEmpty(transaction?.Description) ? "sem descrição" : transaction?.Description)</p>
				<p style="text-align: left; width: 95px; font-size: 13.5px;">R$ @transaction?.Value.ToString("F2")</p>
				<p>@colorsList</p>
			</div>
		}
	</div>
	@* <input type="color" @onchange="ChangeTitleColor" class="input-title-color" value="@headColor" /> *@
</section>

